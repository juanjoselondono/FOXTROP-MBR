<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Physical Camera Link -->
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.015 0.05 0.015"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.015 0.05 0.015"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
        </inertial>
    </link>

    <joint name="camera_chassis_joint" type="fixed">
        <parent link="chassis"/>
        <child link="camera_link"/>
        <!-- Placed at the front of the chassis. Adjust X and Z as necessary -->
        <origin xyz="0.1 0 0.1" rpy="0 0 0"/>
    </joint>

    <!-- Virtual Optical Link for ROS 2 Image Data Convention -->
    <link name="camera_link_optical"></link>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <!-- Gazebo Camera Configuration -->
    <gazebo reference="camera_link">
        <sensor name="robot_camera" type="camera">
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>camera/image_raw</topic>
            <!-- Data bound to the optical frame -->
            <gz_frame_id>camera_link_optical</gz_frame_id>

            <camera>
                <!-- Widened to 1.57 radians (90 degrees) for peripheral vision -->
                <horizontal_fov>1.57</horizontal_fov> 
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>15.0</far> <!-- Extended view distance -->
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>

</robot>