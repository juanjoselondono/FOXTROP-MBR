<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="car_track_world">

    <!-- Core Engine Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>
    
    <!-- 1. Physics Configuration -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <gravity>0 0 -9.80665</gravity>
    </physics>

    <!-- 2. Scene Environment -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <!-- 3. Global Illumination -->
    <light type="directional" name="main_sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 4. Base Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Shared Track PBR Material macro logic represented natively -->

    <!-- 6. Bridge 1 -->
    <model name="simple_bridge">
      <pose>0 10 0.0 0 0 0</pose>
      <static>true</static>
      <link name="bridge_surface">
        <pose>0 0 2.0 0 0 0</pose>
        <collision name="surface_col">
          <geometry><box><size>10.0 3.0 0.2</size></box></geometry>
        </collision>
        <visual name="surface_vis">
          <geometry><box><size>10.0 3.0 0.2</size></box></geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>lane_texture.png</albedo_map>
                <roughness>0.8</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <!-- Walls -->
        <collision name="wall_left_col"><pose>0 1.45 0.35 0 0 0</pose><geometry><box><size>10.0 0.1 0.5</size></box></geometry></collision>
        <visual name="wall_left_vis"><pose>0 1.45 0.35 0 0 0</pose><geometry><box><size>10.0 0.1 0.5</size></box></geometry><material><ambient>0.8 0.4 0.0 1</ambient><diffuse>0.8 0.4 0.0 1</diffuse></material></visual>
        <collision name="wall_right_col"><pose>0 -1.45 0.35 0 0 0</pose><geometry><box><size>10.0 0.1 0.5</size></box></geometry></collision>
        <visual name="wall_right_vis"><pose>0 -1.45 0.35 0 0 0</pose><geometry><box><size>10.0 0.1 0.5</size></box></geometry><material><ambient>0.8 0.4 0.0 1</ambient><diffuse>0.8 0.4 0.0 1</diffuse></material></visual>
      </link>
      <link name="pillar_left">
        <pose>-4.0 0 1.0 0 0 0</pose>
        <collision name="pillar1_col"><geometry><cylinder><radius>0.4</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="pillar1_vis"><geometry><cylinder><radius>0.4</radius><length>2.0</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
      <link name="pillar_right">
        <pose>4.0 0 1.0 0 0 0</pose>
        <collision name="pillar2_col"><geometry><cylinder><radius>0.4</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="pillar2_vis"><geometry><cylinder><radius>0.4</radius><length>2.0</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

